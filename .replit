modules = ["nodejs-20", "web"]

[nix]
channel = "stable-25_05"

[agent]
expertMode = true

[workflows]
runButton = "Project"

[[workflows.workflow]]
name = "Project"
mode = "parallel"
author = "agent"

[[workflows.workflow.tasks]]
task = "workflow.run"
args = "Start application"

[[workflows.workflow]]
name = "Start application"
author = "agent"

[workflows.workflow.metadata]
outputType = "webview"

[[workflows.workflow.tasks]]
task = "shell.exec"
args = "if ! test -x apps/shell/node_modules/.bin/vite || ! test -x apps/booking-angular/node_modules/.bin/ng; then pnpm install --no-frozen-lockfile || exit 1; fi; pnpm dev"
waitForPort = 5000

[[ports]]
localPort = 3002
externalPort = 80

[[ports]]
localPort = 3003
externalPort = 3003

[[ports]]
localPort = 5000
externalPort = 5000
